[application]

config/name="Toppler"
run/main_scene="res://Scenes/TopplerMenu/EnhancedTopplerMenu.tscn"
config/icon="res://Assets/graphics/kenney_physicsAssets_v2/PNG/Aliens/alienGreen_square.png"

[autoload]

Globals="*res://Globals/Globals.gd"
PlayerProfile="*res://Globals/PlayerProfile.gd"
GameManager="*res://Globals/GameManager.gd"
RageSystem="*res://Globals/RageSystem.gd"

[display]

window/size/width=950
window/size/height=540
window/stretch/mode="2d"
window/stretch/aspect="expand"

[importer_defaults]

ogg_vorbis={
"loop": false,
"loop_offset": 0
}

